{
  "expo": {
    "name": "QuantumFlow Edge",
    "slug": "quantumflow-edge",
    "version": "1.4.1",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060B18",
    "splash": {
      "backgroundColor": "#060B18"
    },
    "android": {
      "package": "com.quantumflow.edge",
      "versionCode": 5
    },
    "ios": {
      "bundleIdentifier": "com.quantumflow.edge",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/QuantumFlow-Edge"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      "expo-font"
    ]
  }
}
